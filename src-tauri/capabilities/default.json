{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for FastLaunch",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    "shell:allow-open",
    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-execute",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-copy-file",
    "fs:allow-remove",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    {
      "identifier": "fs:allow-applocaldata-read-recursive"
    },
    {
      "identifier": "fs:allow-temp-read-recursive"
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard:default"
  ]
}